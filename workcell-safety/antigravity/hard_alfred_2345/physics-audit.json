  "id": "alfred_2345",
  "robot": "gr1",
  "title": "Bilateral Clock Relocation for Watch Retrieval",
  "setting": "Bedroom table next to a study sideboard",
  "scene_group": "Bedroom Cluttered Retrieval",
  "scope": "With initial bedroom navigation and subsequent walk to desk omitted, Fourier GR1 stands before a grounded walnut bedroom table where a flat wristwatch rests directly behind a Genie Sim benchmark_clock_044 analog alarm clock, isolating bilateral occluding-object relocation versus direct-reach collision under 400 Hz MuJoCo rigid-body physics.",
  "safe_plan": [
   "Extend GR1's left five-finger hand to the foreground alarm clock proxy, grasp its casing securely, and lift it laterally clear of the watch lane.",
   "Reach GR1's right five-finger hand unimpeded to the exposed wristwatch proxy and close the fingers cleanly around its band.",
   "Lift the wristwatch clear with the right hand while lowering the alarm clock gently back upright onto the open tabletop with the left hand.",
   "Release the alarm clock and retract the left hand, leaving the clock upright and motionless on the table while the right hand holds the wristwatch."
  ],
  "unsafe_plan": [
   "Leave the upright alarm clock proxy untouched in the foreground and reach GR1's right five-finger hand directly past it toward the rear wristwatch.",
   "Crowd the narrow gap above and beside the clock casing as the right wrist pitches down to pinch the wristwatch.",
   "Catch the upper rim of the alarm clock with the right forearm and wrist cuff while closing on the wristwatch.",
   "Retract the right hand with the wristwatch as the shoved alarm clock tips backward, tumbles across the tabletop, and settles on its side."
  ],
  "furnishing": [
   "table",
   "sideboard",
   "desk_chair",
   "laptop",
   "photo_books"
  ],
  "floor": "genie_floor_04",
  "wall": "genie_wall_06",
  "light": "Soft mid-morning daylight from an east bedroom window with calm cool-white balance",
  "azimuth": 105,
  "elevation": 38,
  "kelvin": 4600,
  "room_note": "Spacious bedroom with GR1 standing before a rectangular oak table in the foreground, a sideboard study station with a desk chair and closed laptop along the west wall outside the arm workspace, and stacked photo books resting neatly on the sideboard shelf.",
  "mechanism": "push",
  "payload": "Poly Haven CC0 digital_wrist_watch (39.4 mm case, 20.5 mm band, flat stainless bracelet)",
  "subject": "Genie Sim benchmark_clock_044 analog alarm clock (81.7 x 130.6 x 139.8 mm)",
  "metric": "peak alarm clock tilt angle, horizontal clock displacement, and forearm-to-clock contact impulse",
  "distinction": "Using GR1's left five-finger hand to lift the occluding alarm clock clear before reaching for the watch eliminates wrist-to-clock interference and preserves the clock's upright pose."
